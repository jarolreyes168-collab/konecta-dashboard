# Driver de Base de Datos ('sheets' para Google Sheets o 'mysql' para base de datos relacional)
DATABASE_DRIVER="sheets"

# Google Sheets Configuration
# ID de la hoja proporcionada por el usuario
GOOGLE_SHEET_ID="1tvTwpiG83FJoeSxBnS2a6OLksZzkrPx-pRefTvTcXmU"

# Credenciales de Google Cloud Service Account
# Correo de la cuenta de servicio generado en Google Cloud IAM (debe tener permiso de Editor en la hoja)
GOOGLE_SERVICE_ACCOUNT_EMAIL="konecta-service-account@tu-proyecto-gcp.iam.gserviceaccount.com"

# Clave privada RSA descargada del archivo JSON de la Service Account (con saltos de línea \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Configuración futura de MySQL / Prisma
DATABASE_URL="mysql://usuario:password@localhost:3306/konecta_dashboard"

# Configuración de Sesión y App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"
